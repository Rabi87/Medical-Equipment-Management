# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medical_equipment_db
DB_USER=medical_user
DB_PASS=your_secure_password_here

# Application Settings
APP_NAME=Medical Equipment Management System
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080/care-devices

# Session Settings
SESSION_LIFETIME=120
SESSION_SECURE=true
SESSION_HTTP_ONLY=true

# Email Notifications (for future versions)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_email_password
MAIL_ENCRYPTION=tls

# Logging
LOG_CHANNEL=daily
LOG_MAX_FILES=30
LOG_LEVEL=warning

# Backup Settings
BACKUP_ENABLED=true
BACKUP_SCHEDULE=daily
BACKUP_RETENTION_DAYS=30

# Notification Settings (for v2.0)
SMS_ENABLED=false
EMAIL_ENABLED=false
WHATSAPP_ENABLED=false
